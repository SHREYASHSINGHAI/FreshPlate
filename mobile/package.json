{
  "name": "freshplate-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test:smoke": "npx tsx test-release-smoke.cjs",
    "test:compliance": "node test-store-compliance.cjs",
    "test:systems": "npx tsx test-mobile-systems.cjs",
    "test:all": "npx tsx test-release-smoke.cjs && node test-store-compliance.cjs && npx tsx test-mobile-systems.cjs",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "eas build --platform all --profile production",
    "build:check": "node build-release-artifacts.cjs",
    "build:preview": "eas build --platform all --profile preview",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "expo": "~52.0.0",
    "expo-build-properties": "~0.13.3",
    "expo-camera": "~16.0.17",
    "expo-file-system": "~18.0.12",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "react": "18.3.1",
    "react-native": "0.76.7"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  },
  "private": true
}
