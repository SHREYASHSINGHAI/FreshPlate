# =================================================================
# FreshPlate Production & Development Environment Blueprint
# =================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV="production"

# Google Gemini AI Configuration (Server-Side Only - NEVER expose to client)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins. Use '*' for open mobile access or specific URLs.
CORS_ORIGINS="https://freshplate.app,https://api.freshplate.app,capacitor://localhost,http://localhost"

# Security & Rate Limiting Controls (per IP window)
# RATE_LIMIT_MAX: Max requests per 15 minutes for general endpoints (default: 100)
RATE_LIMIT_MAX="100"

# VISION_RATE_LIMIT_MAX: Max requests per 5 minutes for AI image scanning (default: 30)
VISION_RATE_LIMIT_MAX="30"

# RECIPE_RATE_LIMIT_MAX: Max requests per 5 minutes for AI recipe generation (default: 30)
RECIPE_RATE_LIMIT_MAX="30"

# Backend Firebase / Firestore (Optional overrides; falls back to default project if omitted)
FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
FIREBASE_AUTH_DOMAIN="freshplate-10d10.firebaseapp.com"
FIREBASE_PROJECT_ID="freshplate-10d10"
FIREBASE_STORAGE_BUCKET="freshplate-10d10.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="32026376878"
FIREBASE_APP_ID="1:32026376878:web:bb27be1eee6f43a64f8b3f"

# Client-Side Web / Vite Build Variables (Prefixed with VITE_)
VITE_GOOGLE_CLIENT_ID="815767207816-1gs6ule19796fcsvhqcjso9ased07iaa.apps.googleusercontent.com"
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="freshplate-10d10.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="freshplate-10d10"
VITE_FIREBASE_STORAGE_BUCKET="freshplate-10d10.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="32026376878"
VITE_FIREBASE_APP_ID="1:32026376878:web:bb27be1eee6f43a64f8b3f"
VITE_ADMIN_EMAIL="shreyashsinghai2005@gmail.com"
